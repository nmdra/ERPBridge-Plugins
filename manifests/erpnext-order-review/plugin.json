{
  "apiVersion": "erpbridge.io/v1",
  "kind": "Plugin",
  "metadata": {
    "name": "sales-order-ai-review",
    "version": "1.0.0",
    "type": "api",
    "isActive": false
  },
  "spec": {
    "endpoint": "https://order-review.example.invalid",
    "timeoutMilliseconds": 15000,
    "auth": {
      "type": "api-key",
      "header": "X-API-Key",
      "credentialRef": "PLUGIN_ORDER_REVIEW_KEY"
    }
  }
}
